[Desktop Entry]
Type=Application
Name=ENG Drawing Viewer
GenericName=Engineering Drawing Viewer
Comment=View, mark up and convert engineering drawings offline
Exec=eng-drawing-viewer %F
Icon=io.github.ca_works.ENGDrawingViewer
Terminal=false
Categories=Graphics;Viewer;Engineering;
Keywords=PDF;drawing;markup;CAD;DXF;SVG;PowerPoint;
MimeType=application/pdf;image/png;image/jpeg;image/tiff;image/webp;image/bmp;image/gif;image/heic;image/heif;image/svg+xml;image/vnd.dxf;inode/directory;
StartupWMClass=io.github.ca_works.ENGDrawingViewer
