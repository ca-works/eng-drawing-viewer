# Keep LF line endings on every platform, so a build from a Windows checkout contains exactly
# the same text files as a build from the published source archive.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.icns binary

# Published release files are kept byte-for-byte (their SHA-256 is checked by tools/publish_winlinux_231.sh).
docs/release-2.3.1-winlinux/THIRD_PARTY_NOTICES-*.txt -text
